<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Tray Hardware Monitor</AssemblyTitle>
    <Product>Tray Hardware Monitor</Product>
    <Description>LibreHardwareMonitorLib tabanlı ultra hafif sistem tepsisi ve Bento UI v2 web telemetri izleyicisi</Description>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Authors>fth2745</Authors>
    <RepositoryUrl>https://github.com/fth2745/TrayHardwareMonitor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UIv2\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
